{
  "info": {
    "name": "Online Bookstore API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/online-bookstore"
    }
  ],
  "item": [
    {
      "name": "1. Books",
      "item": [
        {
          "name": "All books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Filter + sort",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?category=Fantasy&sort=price_desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Fantasy"
                },
                {
                  "key": "sort",
                  "value": "price_desc"
                }
              ]
            }
          }
        },
        {
          "name": "Book by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "1"
              ]
            }
          }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/search?keyword=harry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "search"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": "harry"
                }
              ]
            }
          }
        },
        {
          "name": "By category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/category/Fiction",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "category",
                "Fiction"
              ]
            }
          }
        },
        {
          "name": "Featured",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/featured",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "featured"
              ]
            }
          }
        },
        {
          "name": "Popular",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/popular",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "popular"
              ]
            }
          }
        },
        {
          "name": "New arrivals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/new",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "new"
              ]
            }
          }
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "categories"
              ]
            }
          }
        },
        {
          "name": "Book not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "9999"
              ]
            }
          }
        },
        {
          "name": "Bad id (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "abc"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Users (run in order; Postman keeps the session cookie)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha Rao\",\n  \"email\": \"asha@example.com\",\n  \"password\": \"Books1234\",\n  \"phone\": \"9876543210\"\n}"
            }
          }
        },
        {
          "name": "Register duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha Rao\",\n  \"email\": \"asha@example.com\",\n  \"password\": \"Books1234\",\n  \"phone\": \"9876543210\"\n}"
            }
          }
        },
        {
          "name": "Register weak password (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha Rao\",\n  \"email\": \"x@example.com\",\n  \"password\": \"abc\",\n  \"phone\": \"9876543210\"\n}"
            }
          }
        },
        {
          "name": "Login wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha@example.com\",\n  \"password\": \"nope\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha@example.com\",\n  \"password\": \"Books1234\"\n}"
            }
          }
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Cart (login first)",
      "item": [
        {
          "name": "Add book 1 x2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 1,\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "Add book 1 again (quantity merges)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 1,\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "Add more than stock (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 14,\n  \"quantity\": 50\n}"
            }
          }
        },
        {
          "name": "Add out-of-stock book (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 10,\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "Add quantity 0 (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 1,\n  \"quantity\": 0\n}"
            }
          }
        },
        {
          "name": "View cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart"
              ]
            }
          }
        },
        {
          "name": "Update item quantity (use an id from View cart)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 4\n}"
            }
          }
        },
        {
          "name": "Remove item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Orders (login, add items first)",
      "item": [
        {
          "name": "Checkout invalid pincode (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha Rao\",\n  \"email\": \"asha@example.com\",\n  \"phone\": \"9876543210\",\n  \"address\": \"12 MG Road\",\n  \"city\": \"Chennai\",\n  \"pincode\": \"12\"\n}"
            }
          }
        },
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha Rao\",\n  \"email\": \"asha@example.com\",\n  \"phone\": \"9876543210\",\n  \"address\": \"12 MG Road\",\n  \"city\": \"Chennai\",\n  \"pincode\": \"600001\"\n}"
            }
          }
        },
        {
          "name": "Checkout with empty cart (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha Rao\",\n  \"email\": \"asha@example.com\",\n  \"phone\": \"9876543210\",\n  \"address\": \"12 MG Road\",\n  \"city\": \"Chennai\",\n  \"pincode\": \"600001\"\n}"
            }
          }
        },
        {
          "name": "Order by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "1"
              ]
            }
          }
        },
        {
          "name": "Order history (use your user id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1",
                "orders"
              ]
            }
          }
        }
      ]
    }
  ]
}